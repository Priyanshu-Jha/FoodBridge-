# Optional: secure routing provider for Day 23.
# If set, map routing uses Mapbox Directions API.
# If omitted, app falls back to public OSRM routing.
VITE_MAPBOX_DIRECTIONS_TOKEN=

# Backend API base URL for frontend requests.
# Example (local): http://localhost:8080
# Example (deployed): https://foodbridge-backend-xxxx.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Optional override for websocket endpoint base URL.
# If omitted, defaults to ${VITE_API_BASE_URL}/ws
VITE_WS_BASE_URL=

# Optional routing profile for Mapbox: driving, driving-traffic, walking, cycling
VITE_MAPBOX_PROFILE=driving
